.PHONY: run build build-nocache ttm glfw-layer-shell browser

# raylib-go compiles GLFW from vendored C sources; the layer-shell patch
# overlays a modified copy of the Wayland backend on top of them.
GLFW_SRC = vendor/github.com/gen2brain/raylib-go/raylib/external/glfw/src
GO = go

# Builds the GLFW Wayland backend with wlr-layer-shell support: windows
# created while GLFW_WLR_LAYER_SHELL=1 are mapped as overlay layer surfaces
# covering a whole output (above bars, menus and floating windows). The
# patched sources live in patches/glfw-wayland-layer-shell.
#
# The Go build cache does not key on vendored C sources, so the marker file
# generated below (with the patch content hash in it) is what actually
# invalidates the cgo build when the GLFW patch changes.
glfw-layer-shell:
	$(GO) mod vendor
	cp patches/glfw-wayland-layer-shell/* $(GLFW_SRC)/
	printf 'package rl\n\n// Code generated by make glfw-layer-shell. DO NOT EDIT.\n// Bumps the cgo build cache when the vendored GLFW patch changes.\n// Patch hash: %s\n' "$$(cat patches/glfw-wayland-layer-shell/* | md5sum | cut -d' ' -f1)" > vendor/github.com/gen2brain/raylib-go/raylib/zz_layershell_marker.go

run: glfw-layer-shell
	$(GO) run -mod=vendor *.go

build: glfw-layer-shell
	$(GO) build -mod=vendor -o JohnnyCastaway2026 .

ttm: glfw-layer-shell
	$(GO) run -mod=vendor *.go "ttm"

build-nocache: glfw-layer-shell
	$(GO) build -mod=vendor -a .

runsm:
	./JohnnyCastaway2026 display 0:1728x1117

runbg:
	./JohnnyCastaway2026 display 1:1920x1080

runboth:
	./JohnnyCastaway2026 display 0:1728x1117 &
	./JohnnyCastaway2026 display 1:1920x1080

browser: glfw-layer-shell
	$(GO) run -mod=vendor main.go resource.go util.go uncompress.go browser.go browser
